# The Fastify backend's base URL. Server-only — the browser never sees
# this, since every API call goes through this app's own /api/proxy route.
BACKEND_API_URL=http://localhost:4000

# Must be IDENTICAL to pictionary-be's JWT_SECRET — this app only verifies
# tokens (for the proxy.ts route gate), it never issues them.
JWT_SECRET=replace-with-the-same-secret-as-the-backend-at-least-32-characters

# Public on purpose — unlike BACKEND_API_URL, the browser connects to the
# Socket.IO server directly (a WebSocket can't be proxied through a Next.js
# route handler the way a REST request can). No token rides along for guest
# play, so exposing this URL isn't a secret the way BACKEND_API_URL is.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
